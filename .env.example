# AstroCap configuration
# Copy to .env and adjust for your setup:
#   cp .env.example .env

# Flask listen port
ASTROCAP_PORT=7777

# Where captures, DB, and plate-solve outputs are stored
ASTROCAP_OUTDIR=/data
ASTROCAP_LOCAL_OUTDIR=/data_local

# SQLite database path (defaults to $ASTROCAP_OUTDIR/astrocap.db)
ASTROCAP_DB_PATH=/data/astrocap.db

# Hard memory cap in GB (prevents OOM during plate solving)
ASTROCAP_MAX_RAM_GB=4

# URL of the nikon_bulb_server Rust camera bridge
GPHOTO_API_BASE=http://127.0.0.1:8080

# Plate-solving backend: local (ASTAP, offline), siril, or default (online)
ASTROCAP_SOLVER_BACKEND=local

# HTTP timeout for camera bridge calls (seconds)
ASTROCAP_HTTP_TIMEOUT=20

# Gunicorn production server settings
# Workers: 2-4 is plenty for a single-user astro rig
GUNICORN_WORKERS=2
# Threads per worker for concurrent I/O (camera bridge polls)
GUNICORN_THREADS=4
# Timeout in seconds — long exposures need this
GUNICORN_TIMEOUT=180
